{ #category : 'as yet unclassified' }
RandomDistributionsTest >> testBernoulli [

	| gen |
	gen := (Random seed: 13) fairCoin.

	self exportSlotsGraphOf: gen.

	self
		assert: ((1 to: 1000) collect: [ :each1 | gen next ])
		equals: self expectedValue_testBernoulli
]

{ #category : 'as yet unclassified' }
RandomDistributionsTest >> testBinomial [

	| gen |
	gen := (RandomBinomial seed: 13)
		       p: 0.7;
		       n: 20;
		       yourself.

	self exportSlotsGraphOf: gen.

	self
		assert: ((1 to: 1000) collect: [ :each1 | gen next ])
		equals: self expectedValue_testBinomial
]

{ #category : 'as yet unclassified' }
RandomDistributionsTest >> testExponential [

	| gen |
	gen := RandomExponential seed: 13.

	self exportSlotsGraphOf: gen.

	self
		assertSamples: ((1 to: 1000) collect: [ :each1 | gen next ])
		closeTo: self expectedValue_testExponential
]

